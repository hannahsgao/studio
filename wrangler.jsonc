{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "hannahgao.studio",
      "custom_domain": true
    }
  ]
}
